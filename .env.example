# ============================================================================
# Discord Radio Bot — Environment Configuration Template
# ============================================================================
# Copy this file to .env:   cp .env.example .env
# Then fill in your real values below.
# NEVER commit .env to version control — it's already in .gitignore.
# ============================================================================

# ---------------------------------------------------------------------------
# Required: Your Discord bot token
# Get one at https://discord.com/developers/applications
# ---------------------------------------------------------------------------
DISCORD_TOKEN=your_bot_token_here

# ---------------------------------------------------------------------------
# Discord server IDs (must be integers, 17–20 digits)
# See the readme for step-by-step instructions on finding these.
# ---------------------------------------------------------------------------
GUILD_ID=0
VOICE_CHANNEL_ID=0
TEXT_CHANNEL_ID=0

# ---------------------------------------------------------------------------
# Admin role ID — set to 0 to let everyone use bot commands
# ---------------------------------------------------------------------------
ADMIN_ROLE_ID=0

# Discord user ID of the bot owner — receives DM notifications
# (e.g., when new .env keys are auto-added after a git pull).
ADMIN_USER_ID=0

# Set to "true" if the bot is managed by systemd / NSSM / Docker.
# When new .env keys are auto-synced, the bot exits so the service
# manager restarts it.  If false (default), the owner gets a DM.
RUNNING_AS_SERVICE=false

# ---------------------------------------------------------------------------
# Music folder — where your audio files live.
# Can be an absolute path like C:\Users\You\Music
# or a relative path like ./music (folder next to bot.py)
# ---------------------------------------------------------------------------
MUSIC_FOLDER=./music

# ---------------------------------------------------------------------------
# Default volume (0.0 = silent, 1.0 = 100%).
# Applied when a new song starts. Users can change it with !volume.
# ---------------------------------------------------------------------------
DEFAULT_VOLUME=0.3

# ---------------------------------------------------------------------------
# When the voice channel is empty, this controls whether the bot pauses
# playback after AFK_TIMEOUT_SECONDS.
# Set to "false" to keep playing music regardless of listeners.
# ---------------------------------------------------------------------------
AFK_TIMEOUT_SECONDS=60
AFK_PAUSE_ON_EMPTY=true

# ---------------------------------------------------------------------------
# If true, the bot automatically leaves the voice channel after the AFK
# timeout expires (only takes effect when AFK_PAUSE_ON_EMPTY is also true).
# Set to "false" to keep the bot in the channel while paused, so it can
# auto-resume when someone joins.
# ---------------------------------------------------------------------------
AFK_AUTO_LEAVE=true

# Voice channel status text shown when nobody is listening and the bot is idle.
# You can use emoji — no quotes needed.
VOICE_IDLE_STATUS=🎧 PAUSED

# ---------------------------------------------------------------------------
# Optional: Path to a 1280×720 JPG banner image displayed at the top of the
# Now Playing embed.  Defaults to "./vibed_header.jpg" if not set.
# Leave empty to disable the header entirely.
# ---------------------------------------------------------------------------
HEADER_IMAGE_PATH=./vibed_header.jpg

# ---------------------------------------------------------------------------
# Display toggles — control which elements appear in the Now Playing embed.
# Set any of these to "false" to hide that element from the embed display.
# Accepts: true/false, yes/no, 1/0, on/off
# ---------------------------------------------------------------------------
SHOW_UP_NEXT=true
SHOW_NOW_PLAYING=true
SHOW_ALBUM_ART=true

# Show/hide the PREV and NEXT buttons on the Now Playing embed.
# Set to "true" to let users skip tracks via buttons.
# Set to "false" (default) to hide them — only admins can skip with !skip.
SHOW_SKIP_BUTTONS=false

# ---------------------------------------------------------------------------
# Metadata format — controls the embed description line below the track title.
# Use these placeholders: {artist}  {title}  {album}  {duration}
# Duration renders as M:SS.  Spacer characters ( · ) are optional — add your
# own text, brackets, pipes, or whatever you like.
# ---------------------------------------------------------------------------
METADATA_FORMAT={artist} · {album} · {duration}

# ---------------------------------------------------------------------------
# Voting & auto-delete — fine-tune how multi-user voting and cleanup work.
# ---------------------------------------------------------------------------
# How long (in seconds) a vote stays open before being tallied.
VOTE_TIMEOUT_SECONDS=10
# Required YES ratio for a vote to pass.  0.75 = 75% of voters must say YES.
VOTE_THRESHOLD=0.75
# Bot confirmation, error, and vote-result messages delete after this many seconds.
AUTO_DELETE_TIMEOUT=20

# ---------------------------------------------------------------------------
# Multi-folder music selection (optional)
# ---------------------------------------------------------------------------
# When enabled, the bot owner can configure multiple music folders with
# display names.  Users (or just admins, depending on permission below)
# can switch between them with the !switch command.
#
# Set to "true" to enable the multi-folder feature.
FOLDER_SELECTION_ENABLED=false

# Who can use !folders and !switch: "all" (anyone) or "admin" (admins only).
FOLDER_SELECTION_PERMISSION=admin

# JSON mapping of display name → folder path.
# Example: {"Rock Music": "./music/Rock", "Lofi Beats": "./music/Lofi", "Classical": "./music/Classic"}
# Leave as "{}" to disable.  Falls back to MUSIC_FOLDER when no folder is selected.
MUSIC_FOLDERS_JSON={}


